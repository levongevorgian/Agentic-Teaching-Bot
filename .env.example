# Copy this file to .env and fill local values. Never commit real secrets.
TELEGRAM_BOT_TOKEN=

# Local LLM: use a vLLM or llama.cpp OpenAI-compatible server.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=local-model
LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=90

# Web search. If empty or unavailable, the app uses a small curated fallback list.
SEARCH_BACKEND=duckduckgo
SEARCH_TIMEOUT_SECONDS=10

# SMTP email settings. Leave blank while testing previews.
# For Gmail, SMTP_PASSWORD should be an app password stored only in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional PDF font override. Use a TTF/TTC font with Armenian/Unicode coverage.
# Example: assets/fonts/NotoSansArmenian-Regular.ttf
TEACHING_BOT_PDF_FONT_PATH=
